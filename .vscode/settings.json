{
  // When you paste or drag an image into a page, VS Code copies it here
  // and writes the Markdown image line for you.
  // The first pattern that matches the page you're editing wins.
  // New project? Copy a project line and change both folder names.
  "markdown.copyFiles.destination": {
    "docs/blog/posts/**": "${documentWorkspaceFolder}/docs/assets/images/blog/${fileName}",
    "docs/projects/desktop-charts/**": "${documentWorkspaceFolder}/docs/assets/images/desktop-charts/${fileName}",
    "docs/projects/dividend-dashboard/**": "${documentWorkspaceFolder}/docs/assets/images/dividend-dashboard/${fileName}",
    "docs/projects/**": "${documentWorkspaceFolder}/docs/assets/images/${fileName}"
  },
  "markdown.copyFiles.overwriteBehavior": "nameIncrementally",
  "files.trimTrailingWhitespace": false
}